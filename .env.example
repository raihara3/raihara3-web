# microCMS service subdomain (the "xxxx" in https://xxxx.microcms.io)
MICROCMS_SERVICE_DOMAIN=

# microCMS API key with GET permission (server-side only)
MICROCMS_API_KEY=

# Secret for verifying the microCMS webhook HMAC-SHA256 signature.
# Set the same value in the microCMS webhook settings (any random string).
MICROCMS_WEBHOOK_SECRET=
